{
  "pet": "rocky",
  "sounds": true,
  "volume": 0.5,
  "scale": 0.5,
  "doneTimeoutMin": 10,
  "thoughtSeconds": 8,
  "screensaverDim": 0.35,
  "sound": {
    "notification": "/usr/share/sounds/freedesktop/stereo/message-new-instant.oga",
    "critical": "/usr/share/sounds/freedesktop/stereo/dialog-warning.oga",
    "attention": "/usr/share/sounds/freedesktop/stereo/window-attention.oga",
    "done": "/usr/share/sounds/freedesktop/stereo/complete.oga"
  },
  "agents": {
    "example-agent": {
      "dir": "~/.example/sessions",
      "glob": "*.jsonl"
    }
  },
  "signals": {
    "_comment": "regexes (case-insensitive) that map notification wording to agent states; delete a key to keep the default",
    "ignoreApps": "^(system|git|omarchy|notify-send|battery|network|bluetooth|audio|volume)$"
  },
  "screensaverBlur": 1.0,
  "screensaverBrand": true
}
