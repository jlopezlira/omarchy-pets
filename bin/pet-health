#!/bin/bash
# Machine health snapshot for Omarchy Pet, as one JSON line. Root-free, ~1 ms.
set -u
read -r l1 _ _ _ _ < /proc/loadavg
cores=$(nproc)
temp=0
for z in /sys/class/thermal/thermal_zone*; do
  [ "$(cat "$z/type" 2>/dev/null)" = "x86_pkg_temp" ] && temp=$(( $(cat "$z/temp") / 1000 )) && break
done
throttle=0
for f in /sys/devices/system/cpu/cpu*/thermal_throttle/core_throttle_count; do
  [ -r "$f" ] && throttle=$(( throttle + $(cat "$f") ))
done
bat=-1; discharging=false
if [ -r /sys/class/power_supply/BAT0/capacity ]; then
  bat=$(cat /sys/class/power_supply/BAT0/capacity)
  [ "$(cat /sys/class/power_supply/BAT0/status)" = "Discharging" ] && discharging=true
fi
memavail=$(awk '/MemAvailable/{a=$2} /MemTotal/{t=$2} END{printf "%d", a*100/t}' /proc/meminfo)
printf '{"loadPerCore":%.2f,"tempC":%d,"throttle":%d,"batteryPct":%d,"discharging":%s,"memAvailPct":%d,"ts":%d}\n' \
  "$(awk -v l="$l1" -v c="$cores" 'BEGIN{print l/c}')" "$temp" "$throttle" "$bat" "$discharging" "$memavail" "$(date +%s)"
